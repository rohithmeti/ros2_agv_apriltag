<?xml version="1.0" ?>
<robot name="my_robot2" xmlns:xacro="http://www.ros.org/wiki/xacro" >

  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_y}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material><ambient>0 0.2 0.8 1</ambient><diffuse>0 0.2 0.8 1</diffuse></material>
  </gazebo>
  <gazebo reference="caster_wheel_1">
    <mu1>0.001</mu1><mu2>0.001</mu2>
    <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
  </gazebo>
  <gazebo reference="caster_wheel_rear">
    <mu1>0.001</mu1><mu2>0.001</mu2>
    <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
  </gazebo>
  <gazebo reference="left_wheel_1">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
  </gazebo>
  <gazebo reference="right_wheel_1">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
  </gazebo>
  <gazebo reference="lidar_1">
    <material><ambient>0.8 0 0 1</ambient><diffuse>0.8 0 0 1</diffuse></material>
  </gazebo>

  <gazebo reference="lidar_1">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <ignition_frame_id>lidar_1</ignition_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- Front camera: same topic as before (/camera/image_raw) so ros2_hmi2.py still works -->
  <gazebo reference="camera_front_link">
    <sensor name="camera_front" type="camera">
      <topic>/camera/image_raw</topic>
      <update_rate>30</update_rate>
      <ignition_frame_id>camera_front_optical_frame</ignition_frame_id>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>   <!-- 80 deg -->
        <image><width>800</width><height>800</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>300</far></clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- Down camera: wide FOV so a 0.25 m floor tag fits from 0.11 m height
       (floor footprint = 2 * 0.11 * tan(57.3 deg) = 0.34 m) -->
  <gazebo reference="camera_down_link">
    <sensor name="camera_down" type="camera">
      <topic>/camera_down/image_raw</topic>
      <update_rate>30</update_rate>
      <ignition_frame_id>camera_down_optical_frame</ignition_frame_id>
      <camera>
        <horizontal_fov>2.0</horizontal_fov>          <!-- 115 deg -->
        <image><width>640</width><height>640</height><format>R8G8B8</format></image>
        <clip><near>0.02</near><far>10</far></clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
