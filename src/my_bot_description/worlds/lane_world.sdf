<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="lane_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"></plugin>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"></plugin>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"></plugin>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="track">
      <static>true</static>
      <link name="s_bot"><pose>2.5 0 0.01 0 0 0</pose><visual name="v"><geometry><box><size>5.0 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="s_top"><pose>2.5 3.6 0.01 0 0 0</pose><visual name="v"><geometry><box><size>5.0 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="r1"><pose>5.31 0.03 0.01 0 0 0.17</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="r2"><pose>5.90 0.24 0.01 0 0 0.52</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="r3"><pose>6.37 0.64 0.01 0 0 0.87</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="r4"><pose>6.69 1.18 0.01 0 0 1.22</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="r5"><pose>6.80 1.80 0.01 0 0 1.57</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="r6"><pose>6.69 2.41 0.01 0 0 1.91</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="r7"><pose>6.37 2.95 0.01 0 0 2.26</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="r8"><pose>5.90 3.35 0.01 0 0 2.61</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="r9"><pose>5.31 3.57 0.01 0 0 2.96</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>

      <link name="l1"><pose>-0.31 3.57 0.01 0 0 -2.96</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="l2"><pose>-0.90 3.35 0.01 0 0 -2.61</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="l3"><pose>-1.37 2.95 0.01 0 0 -2.26</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="l4"><pose>-1.69 2.41 0.01 0 0 -1.91</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="l5"><pose>-1.80 1.80 0.01 0 0 -1.57</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="l6"><pose>-1.69 1.18 0.01 0 0 -1.22</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="l7"><pose>-1.37 0.64 0.01 0 0 -0.87</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="l8"><pose>-0.90 0.24 0.01 0 0 -0.52</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
      <link name="l9"><pose>-0.31 0.03 0.01 0 0 -0.17</pose><visual name="v"><geometry><box><size>0.75 0.4 0.001</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
    </model>

    <model name="overhead_camera">
      <static>true</static>
      <pose>2.5 1.8 10.0 0 1.5708 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.1</horizontal_fov>
            <image>
              <width>800</width>
              <height>600</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>50</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>overhead_camera/image_raw</topic>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
